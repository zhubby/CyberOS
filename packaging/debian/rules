#!/usr/bin/make -f

DEB_HOST_ARCH ?= $(shell dpkg-architecture -qDEB_HOST_ARCH)

ifeq ($(DEB_HOST_ARCH),arm64)
CYBEROS_VM_DEPENDS = qemu-system-arm, qemu-efi-aarch64
else ifeq ($(DEB_HOST_ARCH),amd64)
CYBEROS_VM_DEPENDS = qemu-system-x86, ovmf
else
$(error Unsupported CyberOS package architecture: $(DEB_HOST_ARCH))
endif

%:
	dh $@ --with dkms

override_dh_auto_build:
	npm ci --registry="$${CYBEROS_NPM_REGISTRY:-https://registry.npmmirror.com}"
	npm --prefix docs ci --registry="$${CYBEROS_NPM_REGISTRY:-https://registry.npmmirror.com}"
	npm run build
	node scripts/prepare-iscsi-dkms.mjs

override_dh_auto_test:
	npm test

# The package is assembled from debian/install. The repository's `make install`
# target is for developer dependency setup and must not run during packaging.
override_dh_auto_install:
	:

# Workspace packages are bundled into the compiled applications. npm leaves
# development-only @cyberos links that point back into the source tree; remove
# them from the staged runtime so the package contains no dangling symlinks.
override_dh_install:
	dh_install
	rm -rf debian/cyberos/usr/lib/cyberos/node_modules/@cyberos

override_dh_gencontrol:
	dh_gencontrol -- -Vcyberos:VmDepends="$(CYBEROS_VM_DEPENDS)"

override_dh_dkms:
	dh_dkms -V 6.18.34

# npm dependencies bundle prebuilt native artifacts for several platforms. The
# foreign .bare and .node files are already stripped and cannot be processed by
# the target architecture's objcopy.
override_dh_strip:
	dh_strip --exclude=.bare --exclude=.node

# Dependency analysis must likewise ignore foreign Bare/native prebuilds and
# musl fallbacks that npm installs alongside the host glibc binaries.
override_dh_shlibdeps:
	dh_shlibdeps --exclude=.bare --exclude=linuxmusl --exclude=.node

# Services are started by the installer after first-boot configuration. Timers
# and units must not be enabled implicitly by debhelper during package install.
override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start
