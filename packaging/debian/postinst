#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
  if ! getent group cyberos >/dev/null; then
    addgroup --system cyberos
  fi
  if ! id cyberos >/dev/null 2>&1; then
    adduser --system --ingroup cyberos --home /cyberos/home/terminal --no-create-home --shell /bin/bash cyberos
  fi
  if ! id cyberos-nfs >/dev/null 2>&1; then
    adduser --system --no-create-home --disabled-login --shell /usr/sbin/nologin cyberos-nfs
  fi
  if ! id cyberos-share >/dev/null 2>&1; then
    adduser --system --no-create-home --disabled-login --shell /usr/sbin/nologin \
      --home /cyberos/home/share cyberos-share
  fi

  install -d -o root -g cyberos -m 0751 /cyberos
  rm -rf -- /cyberos/config
  install -d -o cyberos -g cyberos -m 0750 \
    /cyberos/state /cyberos/state/trash /cyberos/state/reports \
    /cyberos/state/pi-sessions /cyberos/state/pi-agent /cyberos/state/photos \
    /cyberos/state/media-cache /cyberos/state/backup-staging /cyberos/state/vod-player /cyberos/state/bluetooth \
    /cyberos/state/tv /cyberos/state/tv/chromium \
    /cyberos/logs /cyberos/home /cyberos/home/terminal /cyberos/apps \
    /cyberos/system-backups /cyberos/data /cyberos/backup
  install -d -o cyberos -g cyberos -m 0700 \
    /cyberos/state/secrets /cyberos/state/secrets/backup /cyberos/state/secrets/share /cyberos/state/mcp
  install -d -o cyberos -g cyberos -m 0711 /cyberos/vm /cyberos/iso
  install -d -o root -g root -m 0755 /cyberos/home/share /cyberos/state/hostd
  install -d -o root -g root -m 0700 \
    /cyberos/state/hostd/docker-daemon /cyberos/state/hostd/network-manager /cyberos/state/hostd/bluetooth /cyberos/state/shares \
    /cyberos/state/hostd/iscsi /cyberos/state/tv/control /cyberos/system-backups/permissions
  install -d -o root -g root -m 0700 /etc/target

  chown -R root:root /cyberos/state/hostd /cyberos/system-backups/permissions
  usermod --home /cyberos/home/terminal --shell /bin/bash cyberos
  usermod --home /cyberos/home/share cyberos-share

  CYBEROS_LOCALE=${CYBEROS_LOCALE:-C.UTF-8} \
    /usr/lib/cyberos/scripts/cyberos-configure-locale.sh

  install -d -o root -g root -m 0755 /usr/local/sbin
  ln -sfn /usr/lib/cyberos/scripts/cyberos-deploy /usr/local/sbin/cyberos-deploy
  ln -sfn /usr/lib/cyberos/scripts/cyberos-mcp /usr/local/sbin/cyberos-mcp
  ln -sfn /usr/lib/cyberos/scripts/cyberos-tv-mode /usr/local/sbin/cyberos-tv-mode
  /usr/lib/cyberos/scripts/cyberos-deploy-bootstrap.sh

  if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload || true
    systemd-tmpfiles --create cyberos.conf || true
    /usr/lib/cyberos/scripts/cyberos-refresh-groups.sh
  fi
fi

#DEBHELPER#
