#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
  if ! getent group zos >/dev/null; then
    addgroup --system zos
  fi
  if ! id zos >/dev/null 2>&1; then
    adduser --system --ingroup zos --home /zos/home/termux --no-create-home --shell /bin/bash zos
  fi
  if ! id zos-nfs >/dev/null 2>&1; then
    adduser --system --no-create-home --disabled-login --shell /usr/sbin/nologin zos-nfs
  fi
  if ! id zos-share >/dev/null 2>&1; then
    adduser --system --no-create-home --disabled-login --shell /usr/sbin/nologin \
      --home /zos/home/share zos-share
  fi

  install -d -o root -g zos -m 0751 /zos
  install -d -o root -g zos -m 0750 /zos/config
  install -d -o zos -g zos -m 0750 \
    /zos/state /zos/state/trash /zos/state/reports \
    /zos/state/pi-sessions /zos/state/pi-agent /zos/state/photostaff \
    /zos/state/media-cache /zos/state/backup-staging /zos/state/vod-player /zos/state/bluetooth \
    /zos/state/tv /zos/state/tv/chromium \
    /zos/logs /zos/home /zos/home/termux /zos/apps /zos/deploy \
    /zos/system-backups /zos/data/backup /zos/data/primary
  install -d -o zos -g zos -m 0711 /zos/vm /zos/iso
  install -d -o root -g root -m 0755 /zos/home/share /zos/state/hostd
  install -d -o root -g root -m 0700 \
    /zos/state/hostd/docker-daemon /zos/state/hostd/network-manager /zos/state/hostd/bluetooth \
    /zos/state/tv/control /zos/system-backups/permissions

  legacy_migration=0
  if [ -f /etc/sigmaos/config.toml ]; then
    legacy_migration=1
    if ! /usr/lib/zos/scripts/zos-migrate-sigmaos.sh apply; then
      /usr/lib/zos/scripts/zos-migrate-sigmaos.sh rollback || true
      exit 1
    fi
  fi

  chown -R root:root /zos/state/hostd /zos/system-backups/permissions
  if [ -e /zos/config/config.toml ]; then
    chown root:zos /zos/config/config.toml
    chmod 0640 /zos/config/config.toml
  fi
  usermod --home /zos/home/termux --shell /bin/bash zos
  usermod --home /zos/home/share zos-share

  ZOS_LOCALE=${ZOS_LOCALE:-C.UTF-8} \
    /usr/lib/zos/scripts/zos-configure-locale.sh

  install -d -o root -g root -m 0755 /usr/local/sbin
  ln -sfn /usr/lib/zos/scripts/zos-deploy /usr/local/sbin/zos-deploy
  ln -sfn /usr/lib/zos/scripts/zos-mcp /usr/local/sbin/zos-mcp
  ln -sfn /usr/lib/zos/scripts/zos-tv-mode /usr/local/sbin/zos-tv-mode

  if [ "$legacy_migration" = "1" ] && id sigmaos-deploy >/dev/null 2>&1; then
    if ! ZOS_DEPLOY_USER=sigmaos-deploy /usr/lib/zos/scripts/zos-deploy-bootstrap.sh; then
      /usr/lib/zos/scripts/zos-migrate-sigmaos.sh rollback || true
      exit 1
    fi
  fi

  if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload || true
    systemd-tmpfiles --create zos.conf || true
    /usr/lib/zos/scripts/zos-refresh-groups.sh
    /usr/lib/zos/scripts/zos-refresh-termux.sh || true
    /usr/lib/zos/scripts/zos-refresh-vod-player.sh || true
  fi
fi

#DEBHELPER#
