[Unit]
Description=ZOS SQLite and restore staging maintenance
Documentation=file:///usr/share/doc/zos/README.md
After=local-fs.target

[Service]
Type=oneshot
User=zos
Group=zos
Environment=ZOS_ROOT=/zos
Environment=ZOS_CONFIG=/zos/config/config.toml
WorkingDirectory=/zos/state
ExecStart=/usr/local/bin/node /usr/lib/zos/apps/ops/dist/index.js maintenance
TimeoutStartSec=2h
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/zos/state /zos/logs /zos/data /zos/data/backup
NoNewPrivileges=yes
PrivateTmp=yes
CapabilityBoundingSet=
MemoryMax=512M
CPUQuota=100%
TasksMax=128

[Install]
WantedBy=multi-user.target
