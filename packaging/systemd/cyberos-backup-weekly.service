[Unit]
Description=CyberOS weekly restic check and retention
After=local-fs.target cyberos-state-init.service
Requires=cyberos-state-init.service
RequiresMountsFor=/cyberos/data /cyberos/backup
ConditionPathExists=/cyberos/state/secrets/backup/restic-password

[Service]
Type=oneshot
User=cyberos
Group=cyberos
Environment=CYBEROS_ROOT=/cyberos
Environment=CYBEROS_ENVIRONMENT=production
WorkingDirectory=/cyberos/state
ExecStart=/usr/local/bin/node /usr/lib/cyberos/apps/backup/dist/index.js run --kind weekly
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/cyberos/state /cyberos/data /cyberos/backup
NoNewPrivileges=yes
PrivateTmp=yes
CapabilityBoundingSet=
MemoryMax=1G
CPUQuota=250%
TasksMax=256
