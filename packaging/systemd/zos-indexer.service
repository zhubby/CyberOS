[Unit]
Description=ZOS NAS indexer
Documentation=file:///usr/share/doc/zos/README.md
After=local-fs.target zos-api.service
RequiresMountsFor=/zos/data

[Service]
Type=notify
User=zos
Group=zos
Environment=ZOS_ROOT=/zos
Environment=ZOS_CONFIG=/zos/config/config.toml
WorkingDirectory=/zos/state
ExecStart=/usr/lib/zos/bin/zos-indexer
Restart=on-failure
RestartSec=5s
WatchdogSec=20s
TimeoutStopSec=30s
KillMode=control-group
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/zos/state /zos/logs
ReadOnlyPaths=/zos/data
NoNewPrivileges=yes
PrivateTmp=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
MemoryMax=1G
CPUQuota=250%
TasksMax=256

[Install]
WantedBy=multi-user.target
