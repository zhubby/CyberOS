[Unit]
Description=CyberOS TV HDMI-CEC remote input
ConditionPathExists=/cyberos/config/tv-mode/enabled
PartOf=cyberos-tv.target
Requires=cyberos-tv-prepare.service
After=cyberos-tv-prepare.service cyberos-tv-weston.service
Wants=cyberos-tv-weston.service

[Service]
Type=simple
User=cyberos
Group=cyberos
SupplementaryGroups=video input
Environment=XDG_RUNTIME_DIR=/run/cyberos-tv
Environment=WAYLAND_DISPLAY=wayland-0
ExecStart=/usr/lib/cyberos/scripts/cyberos-tv-cec
Restart=always
RestartSec=3
TimeoutStopSec=10s
KillMode=mixed
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/cyberos-tv
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=no
DevicePolicy=closed
DeviceAllow=char-cec rw
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
MemoryMax=64M
TasksMax=32
