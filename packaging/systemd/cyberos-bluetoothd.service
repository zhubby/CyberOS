[Unit]
Description=CyberOS Bluetooth transfer service
Documentation=file:///usr/share/doc/cyberos/README.md
After=dbus.service bluetooth.service local-fs.target cyberos-api.service cyberos-state-init.service
Wants=bluetooth.service cyberos-api.service
Requires=cyberos-api.service cyberos-state-init.service
RequiresMountsFor=/cyberos/data

[Service]
Type=simple
User=cyberos
Group=cyberos
Environment=CYBEROS_ROOT=/cyberos
Environment=CYBEROS_ENVIRONMENT=production
Environment=HOME=/cyberos/state/bluetooth
Environment=XDG_CACHE_HOME=/cyberos/state/bluetooth/cache
WorkingDirectory=/cyberos/state/bluetooth
ExecStart=/usr/bin/dbus-run-session -- /usr/lib/cyberos/bin/cyberos-bluetoothd
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillMode=control-group
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/cyberos/data
ReadWritePaths=/cyberos/state
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_BLUETOOTH
IPAddressDeny=any
CapabilityBoundingSet=
MemoryMax=256M
CPUQuota=100%
TasksMax=128

[Install]
WantedBy=multi-user.target
