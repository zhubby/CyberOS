[Unit]
Description=ZOS health evaluator
After=local-fs.target

[Service]
Type=oneshot
User=zos
Group=zos
Environment=ZOS_ROOT=/zos
Environment=ZOS_CONFIG=/zos/config/config.toml
WorkingDirectory=/zos/state
ExecStart=/usr/local/bin/node /usr/lib/zos/apps/ops/dist/index.js health
TimeoutStartSec=2min
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/zos/state /zos/logs /zos/data /zos/data/backup
NoNewPrivileges=yes
PrivateTmp=yes
CapabilityBoundingSet=
MemoryMax=512M
CPUQuota=100%
TasksMax=128
