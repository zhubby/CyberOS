[Unit]
Description=ZOS HTTP downloader
Documentation=file:///usr/share/doc/zos/README.md
After=network-online.target local-fs.target zos-api.service
Wants=network-online.target
Requires=zos-api.service
RequiresMountsFor=/zos/data

[Service]
Type=simple
User=zos
Group=zos
Environment=ZOS_ROOT=/zos
Environment=ZOS_CONFIG=/zos/config/config.toml
WorkingDirectory=/zos/state
ExecStart=/usr/lib/zos/bin/zos-downloader
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/zos/state /zos/logs /zos/data
NoNewPrivileges=yes
PrivateTmp=yes
CapabilityBoundingSet=
MemoryMax=512M
CPUQuota=150%
TasksMax=256

[Install]
WantedBy=multi-user.target
