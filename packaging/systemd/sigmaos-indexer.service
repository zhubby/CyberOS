[Unit]
Description=SigmaOS NAS indexer
Documentation=file:///usr/share/doc/sigmaos/README.md
After=local-fs.target sigmaos-api.service
RequiresMountsFor=/srv/nas

[Service]
Type=notify
User=sigmaos
Group=sigmaos
Environment=SIGMAOS_CONFIG=/etc/sigmaos/config.toml
WorkingDirectory=/var/lib/sigmaos
StateDirectory=sigmaos
LogsDirectory=sigmaos
ExecStart=/usr/lib/sigmaos/bin/sigmaos-indexer
Restart=on-failure
RestartSec=5s
WatchdogSec=20s
TimeoutStopSec=30s
KillMode=control-group
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/sigmaos /var/log/sigmaos
ReadOnlyPaths=/srv/nas
NoNewPrivileges=yes
PrivateTmp=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
MemoryMax=1G
CPUQuota=250%
TasksMax=256

[Install]
WantedBy=multi-user.target
