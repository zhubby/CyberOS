[Unit]
Description=ZOS agent worker instance %i
Documentation=file:///usr/share/doc/zos/README.md
After=zos-api.service
Requires=zos-api.service

[Service]
Type=simple
User=zos
Group=zos
Environment=ZOS_ROOT=/zos
Environment=ZOS_CONFIG=/zos/config/config.toml
WorkingDirectory=/zos/state
ExecStart=/usr/local/bin/node /usr/lib/zos/apps/worker/dist/index.js
Restart=on-failure
RestartSec=2
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/zos/state /zos/logs /zos/data
NoNewPrivileges=yes
PrivateTmp=yes
CapabilityBoundingSet=
MemoryMax=768M
CPUQuota=200%
TasksMax=256

[Install]
WantedBy=multi-user.target
