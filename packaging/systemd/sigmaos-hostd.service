[Unit]
Description=SigmaOS privileged host integration daemon
Documentation=file:///usr/share/doc/sigmaos/README.md
After=local-fs.target systemd-tmpfiles-setup.service NetworkManager.service
Before=network-online.target
Wants=NetworkManager.service

[Service]
Type=simple
User=root
Group=root
Environment=SIGMAOS_CONFIG=/etc/sigmaos/config.toml
WorkingDirectory=/var/lib/sigmaos
StateDirectory=sigmaos/docker-daemon
StateDirectory=sigmaos/network-manager
StateDirectoryMode=0700
ExecStart=/usr/lib/sigmaos/bin/sigmaos-hostd
Restart=on-failure
RestartSec=3
TimeoutStopSec=180
ProtectSystem=strict
ProtectHome=read-only
# Dynamic share accounts require useradd to atomically replace passwd/shadow files.
ReadWritePaths=/etc /run/sigmaos /run/mdadm /srv/nas
# smbpasswd needs Samba's lock, state, cache, and log directories to initialize its databases.
ReadWritePaths=-/run/samba -/var/lib/samba -/var/cache/samba -/var/log/samba
ReadWritePaths=-/var/lib/sigmaos/docker-daemon /var/lib/sigmaos/network-manager
ReadWritePaths=/var/backups/sigmaos-permissions
NoNewPrivileges=yes
PrivateTmp=yes
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_MKNOD CAP_SYS_ADMIN CAP_SYS_RAWIO
MemoryMax=128M
CPUQuota=50%
TasksMax=128

[Install]
WantedBy=multi-user.target
