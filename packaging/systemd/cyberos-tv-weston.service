[Unit]
Description=CyberOS TV Weston kiosk compositor
ConditionPathExists=/cyberos/config/tv-mode/enabled
PartOf=cyberos-tv.target
Requires=cyberos-tv-prepare.service
After=cyberos-tv-prepare.service seatd.service
Wants=seatd.service

[Service]
Type=simple
User=cyberos
Group=cyberos
SupplementaryGroups=video render input
Environment=XDG_RUNTIME_DIR=/run/cyberos-tv
Environment=XDG_CACHE_HOME=/run/cyberos-tv/cache
Environment=LIBSEAT_BACKEND=seatd
ExecStart=/usr/lib/cyberos/scripts/cyberos-tv-weston
Restart=on-failure
RestartSec=2
TimeoutStopSec=15s
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/cyberos-tv
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=no
DevicePolicy=closed
DeviceAllow=char-drm rw
DeviceAllow=char-input r
RestrictAddressFamilies=AF_UNIX AF_NETLINK
CapabilityBoundingSet=
MemoryMax=256M
TasksMax=128
