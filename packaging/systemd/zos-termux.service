[Unit]
Description=ZOS Rust terminal daemon
Documentation=file:///usr/share/doc/zos/README.md
After=local-fs.target systemd-tmpfiles-setup.service
Wants=local-fs.target

[Service]
Type=simple
User=zos
Group=zos
Environment=ZOS_ROOT=/zos
Environment=ZOS_TERMUX_USER=zos
Environment=ZOS_TERMUX_SOCKET_PATH=/run/zos/termux.sock
Environment=ZOS_TERMUX_SESSION_IDLE_TIMEOUT_MS=1800000
Environment=ZOS_TERMUX_CONNECT_TIMEOUT_MS=10000
Environment=ZOS_TERMUX_MAX_SESSIONS=32
Environment=HOME=/zos/home/termux
WorkingDirectory=/zos/home/termux
KillMode=process
ExecStart=/usr/lib/zos/bin/zos-termux
Restart=on-failure
RestartSec=3
UMask=0007
ProtectSystem=strict
ProtectHome=tmpfs
ReadWritePaths=/run/zos /zos/data /zos/home/termux
InaccessiblePaths=/zos/config /zos/state /zos/logs
NoNewPrivileges=yes
RestrictSUIDSGID=yes
PrivateTmp=yes
CapabilityBoundingSet=
MemoryMax=256M
CPUQuota=100%
TasksMax=128

[Install]
WantedBy=multi-user.target
