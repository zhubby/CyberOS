[Unit]
Description=CyberOS VOD Player
Documentation=file:///usr/share/doc/cyberos/README.md
After=local-fs.target systemd-tmpfiles-setup.service cyberos-api.service bluetooth.service bluealsa.service cyberos-state-init.service
Wants=cyberos-api.service bluetooth.service bluealsa.service
Requires=cyberos-state-init.service

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=20s
User=cyberos
Group=cyberos
Environment=CYBEROS_ROOT=/cyberos
Environment=CYBEROS_ENVIRONMENT=production
Environment=HOME=/cyberos/state/vod-player
Environment=XDG_RUNTIME_DIR=/run/cyberos-tv
Environment=WAYLAND_DISPLAY=wayland-0
WorkingDirectory=/cyberos/state/vod-player
ExecStart=/usr/lib/cyberos/bin/cyberos-vod-player
Restart=on-failure
RestartSec=3
TimeoutStopSec=30s
KillMode=control-group
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/cyberos/data
ReadWritePaths=/run/cyberos /cyberos/state
NoNewPrivileges=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
CapabilityBoundingSet=
MemoryMax=512M
CPUQuota=150%
TasksMax=128

[Install]
WantedBy=multi-user.target
