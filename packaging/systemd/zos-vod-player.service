[Unit]
Description=ZOS VOD Player
Documentation=file:///usr/share/doc/zos/README.md
After=local-fs.target systemd-tmpfiles-setup.service zos-api.service
Wants=zos-api.service

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=20s
User=zos
Group=zos
Environment=ZOS_ROOT=/zos
Environment=ZOS_CONFIG=/zos/config/config.toml
Environment=HOME=/zos/state/vod-player
WorkingDirectory=/zos/state/vod-player
ExecStart=/usr/lib/zos/bin/zos-vod-player
Restart=on-failure
RestartSec=3
TimeoutStopSec=30s
KillMode=control-group
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/zos/data
ReadWritePaths=/run/zos /zos/state/vod-player
NoNewPrivileges=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
CapabilityBoundingSet=
MemoryMax=512M
CPUQuota=150%
TasksMax=128

[Install]
WantedBy=multi-user.target
