[Unit]
Description=CyberOS host and service metrics collector
Documentation=file:///usr/share/doc/cyberos/README.md
After=local-fs.target cyberos-api.service
Wants=cyberos-api.service

[Service]
Type=notify
User=cyberos
Group=cyberos
Environment=CYBEROS_ROOT=/cyberos
Environment=CYBEROS_CONFIG=/cyberos/config/config.toml
WorkingDirectory=/cyberos/state
ExecStart=/usr/lib/cyberos/bin/cyberos-monitor
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillMode=control-group
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=-/cyberos/data
ReadWritePaths=/run/cyberos /cyberos/state
NoNewPrivileges=yes
PrivateTmp=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
MemoryMax=256M
CPUWeight=20
IOWeight=20
TasksMax=64

[Install]
WantedBy=multi-user.target
