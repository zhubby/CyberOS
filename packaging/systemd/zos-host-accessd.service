[Unit]
Description=ZOS restricted container host access proxy
Documentation=file:///usr/share/doc/zos/README.md
After=docker.service local-fs.target
Wants=docker.service
Before=zos-api.service

[Service]
Type=simple
User=zos
Group=zos
SupplementaryGroups=docker
RuntimeDirectory=zos/host-access
RuntimeDirectoryMode=0750
Environment=ZOS_HOST_ACCESS_RUNTIME_ROOT=/run/zos/host-access
Environment=ZOS_DOCKER_SOCKET=/var/run/docker.sock
# Enable only after the deployed collector compatibility suite passes.
Environment=ZOS_HOST_ACCESS_DOCKER_COMPATIBLE=0
ExecStart=/usr/lib/zos/bin/zos-host-accessd
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
UMask=0027
MemoryMax=128M
CPUQuota=50%
TasksMax=128

[Install]
WantedBy=multi-user.target
