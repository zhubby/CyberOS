[Unit]
Description=CyberOS HTTP and BitTorrent downloader
Documentation=file:///usr/share/doc/cyberos/README.md
After=network-online.target local-fs.target cyberos-api.service cyberos-state-init.service
Wants=network-online.target
Requires=cyberos-api.service cyberos-state-init.service
RequiresMountsFor=/cyberos/data

[Service]
Type=simple
User=cyberos
Group=cyberos
Environment=CYBEROS_ROOT=/cyberos
Environment=CYBEROS_ENVIRONMENT=production
WorkingDirectory=/cyberos/state
ExecStart=/usr/lib/cyberos/bin/cyberos-downloader
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/cyberos/state /cyberos/logs /cyberos/data
NoNewPrivileges=yes
PrivateTmp=yes
CapabilityBoundingSet=
MemoryMax=512M
CPUQuota=150%
TasksMax=256

[Install]
WantedBy=multi-user.target
