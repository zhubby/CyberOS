[Unit]
Description=ZOS privileged host integration daemon
Documentation=file:///usr/share/doc/zos/README.md
After=local-fs.target systemd-tmpfiles-setup.service NetworkManager.service
Before=network-online.target
Wants=NetworkManager.service

[Service]
Type=simple
User=root
Group=root
Environment=ZOS_ROOT=/zos
Environment=ZOS_CONFIG=/zos/config/config.toml
WorkingDirectory=/zos/state
ExecStart=/usr/lib/zos/bin/zos-hostd
Restart=on-failure
RestartSec=3
TimeoutStopSec=180
ProtectSystem=strict
ProtectHome=read-only
# Dynamic share accounts require useradd to atomically replace passwd/shadow files.
ReadWritePaths=/etc /run/zos /run/mdadm /zos/config /zos/data
# smbpasswd needs Samba's lock, state, cache, and log directories to initialize its databases.
ReadWritePaths=-/run/samba -/var/lib/samba -/var/cache/samba -/var/log/samba
ReadWritePaths=-/zos/state/hostd/docker-daemon /zos/state/hostd/network-manager
ReadWritePaths=/zos/system-backups/permissions
NoNewPrivileges=yes
PrivateTmp=yes
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_MKNOD CAP_SYS_ADMIN CAP_SYS_RAWIO
MemoryMax=128M
CPUQuota=50%
TasksMax=128

[Install]
WantedBy=multi-user.target
