[Unit]
Description=ZOS host and service metrics collector
Documentation=file:///usr/share/doc/zos/README.md
After=local-fs.target zos-api.service
Wants=zos-api.service

[Service]
Type=notify
User=zos
Group=zos
Environment=ZOS_ROOT=/zos
Environment=ZOS_CONFIG=/zos/config/config.toml
WorkingDirectory=/zos/state
ExecStart=/usr/lib/zos/bin/zos-monitor
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillMode=control-group
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=-/zos/data
ReadWritePaths=/zos/state
NoNewPrivileges=yes
PrivateTmp=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
MemoryMax=256M
CPUWeight=20
IOWeight=20
TasksMax=64

[Install]
WantedBy=multi-user.target
