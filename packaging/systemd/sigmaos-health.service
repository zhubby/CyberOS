[Unit]
Description=SigmaOS health evaluator
After=local-fs.target

[Service]
Type=oneshot
User=sigmaos
Group=sigmaos
Environment=SIGMAOS_CONFIG=/etc/sigmaos/config.toml
WorkingDirectory=/var/lib/sigmaos
StateDirectory=sigmaos
ExecStart=/usr/local/bin/node /usr/lib/sigmaos/apps/ops/dist/index.js health
TimeoutStartSec=2min
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/sigmaos /var/log/sigmaos /srv/nas /srv/backup
NoNewPrivileges=yes
PrivateTmp=yes
CapabilityBoundingSet=
MemoryMax=512M
CPUQuota=100%
TasksMax=128
