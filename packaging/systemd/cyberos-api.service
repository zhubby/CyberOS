[Unit]
Description=CyberOS API and web UI
Documentation=file:///usr/share/doc/cyberos/README.md
After=network-online.target local-fs.target
Wants=network-online.target

[Service]
Type=simple
User=cyberos
Group=cyberos
Environment=CYBEROS_ROOT=/cyberos
Environment=CYBEROS_CONFIG=/cyberos/config/config.toml
Environment=CYBEROS_WEB_DIST=/usr/lib/cyberos/apps/web/dist
Environment=CYBEROS_DOCS_DIST=/usr/lib/cyberos/docs/dist
Environment=CYBEROS_BUILD_INFO_PATH=/usr/lib/cyberos/build-info.json
WorkingDirectory=/cyberos/state
ExecStart=/usr/local/bin/node /usr/lib/cyberos/apps/api/dist/index.js
Restart=on-failure
RestartSec=3
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/cyberos /cyberos/state /cyberos/logs /cyberos/data /cyberos/vm /cyberos/iso /cyberos/apps /cyberos/config/mcp
BindReadOnlyPaths=-/run/libvirt/libvirt-sock
NoNewPrivileges=yes
PrivateTmp=yes
CapabilityBoundingSet=
MemoryMax=512M
CPUQuota=150%
TasksMax=256

[Install]
WantedBy=multi-user.target
