[Unit]
Description=ZOS TV HDMI-CEC remote input
ConditionPathExists=/etc/zos/tv-mode/enabled
PartOf=zos-tv.target
Requires=zos-tv-prepare.service
After=zos-tv-prepare.service zos-tv-weston.service
Wants=zos-tv-weston.service

[Service]
Type=simple
User=zos
Group=zos
SupplementaryGroups=video input
Environment=XDG_RUNTIME_DIR=/run/zos-tv
Environment=WAYLAND_DISPLAY=wayland-0
ExecStart=/usr/lib/zos/scripts/zos-tv-cec
Restart=always
RestartSec=3
TimeoutStopSec=10s
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/zos-tv
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=no
DevicePolicy=closed
DeviceAllow=char-cec rw
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
MemoryMax=64M
TasksMax=32
