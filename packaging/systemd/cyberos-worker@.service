[Unit]
Description=CyberOS agent worker instance %i
Documentation=file:///usr/share/doc/cyberos/README.md
After=cyberos-api.service
Requires=cyberos-api.service

[Service]
Type=simple
User=cyberos
Group=cyberos
Environment=CYBEROS_ROOT=/cyberos
Environment=CYBEROS_CONFIG=/cyberos/config/config.toml
WorkingDirectory=/cyberos/state
ExecStart=/usr/local/bin/node /usr/lib/cyberos/apps/worker/dist/index.js
Restart=on-failure
RestartSec=2
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/cyberos/state /cyberos/logs /cyberos/data
NoNewPrivileges=yes
PrivateTmp=yes
CapabilityBoundingSet=
MemoryMax=768M
CPUQuota=200%
TasksMax=256

[Install]
WantedBy=multi-user.target
