[Unit]
Description=ZOS dedicated WebDAV server
After=network-online.target local-fs.target
Wants=network-online.target
RequiresMountsFor=/zos/data

[Service]
Type=exec
User=www-data
Group=www-data
RuntimeDirectory=zos-webdav
RuntimeDirectoryMode=0700
ExecStart=/usr/sbin/apache2 -DFOREGROUND -f /etc/apache2/sites-available/zos-webdav.conf
ExecReload=/usr/sbin/apache2 -k graceful -f /etc/apache2/sites-available/zos-webdav.conf
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/zos/webdav /zos/data
PrivateTmp=yes
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
