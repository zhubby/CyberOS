[Unit]
Description=ZOS monitoring alert evaluator and delivery worker
Documentation=file:///usr/share/doc/zos/README.md
After=network-online.target local-fs.target zos-api.service zos-monitor.service
Wants=network-online.target zos-api.service zos-monitor.service

[Service]
Type=notify
User=zos
Group=zos
Environment=ZOS_ROOT=/zos
Environment=ZOS_CONFIG=/zos/config/config.toml
WorkingDirectory=/zos/state
ExecStart=/usr/lib/zos/bin/zos-alerter
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillMode=control-group
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=-/zos/data
ReadWritePaths=/zos/state
NoNewPrivileges=yes
PrivateTmp=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=256M
CPUWeight=20
IOWeight=20
TasksMax=64

[Install]
WantedBy=multi-user.target
