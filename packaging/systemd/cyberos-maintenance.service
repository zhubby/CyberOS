[Unit]
Description=CyberOS SQLite and restore staging maintenance
Documentation=file:///usr/share/doc/cyberos/README.md
After=local-fs.target cyberos-state-init.service
Requires=cyberos-state-init.service

[Service]
Type=oneshot
User=cyberos
Group=cyberos
Environment=CYBEROS_ROOT=/cyberos
Environment=CYBEROS_ENVIRONMENT=production
WorkingDirectory=/cyberos/state
ExecStart=/usr/local/bin/node /usr/lib/cyberos/apps/ops/dist/index.js maintenance
TimeoutStartSec=2h
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/cyberos/state /cyberos/logs /cyberos/data /cyberos/backup
NoNewPrivileges=yes
PrivateTmp=yes
CapabilityBoundingSet=
MemoryMax=512M
CPUQuota=100%
TasksMax=128

[Install]
WantedBy=multi-user.target
