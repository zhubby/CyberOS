[Unit]
Description=ZOS TV Chromium shell
ConditionPathExists=/etc/zos/tv-mode/enabled
PartOf=zos-tv.target
Requires=zos-tv-weston.service zos-api.service
After=zos-tv-weston.service zos-api.service

[Service]
Type=simple
User=zos
Group=zos
Environment=HOME=/zos/state/tv
Environment=XDG_RUNTIME_DIR=/run/zos-tv
Environment=WAYLAND_DISPLAY=wayland-0
ExecStart=/usr/lib/zos/scripts/zos-tv-chromium
Restart=on-failure
RestartSec=3
TimeoutStopSec=20s
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/zos-tv /zos/state/tv
NoNewPrivileges=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
CapabilityBoundingSet=
MemoryMax=1G
CPUQuota=250%
TasksMax=512
