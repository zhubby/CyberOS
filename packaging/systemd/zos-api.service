[Unit]
Description=ZOS API and web UI
Documentation=file:///usr/share/doc/zos/README.md
After=network-online.target local-fs.target
Wants=network-online.target

[Service]
Type=simple
User=zos
Group=zos
Environment=ZOS_ROOT=/zos
Environment=ZOS_CONFIG=/zos/config/config.toml
Environment=ZOS_WEB_DIST=/usr/lib/zos/apps/web/dist
Environment=ZOS_DOCS_DIST=/usr/lib/zos/docs/dist
Environment=ZOS_BUILD_INFO_PATH=/usr/lib/zos/build-info.json
WorkingDirectory=/zos/state
ExecStart=/usr/local/bin/node /usr/lib/zos/apps/api/dist/index.js
Restart=on-failure
RestartSec=3
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/zos /zos/state /zos/logs /zos/data /zos/vm /zos/iso /zos/apps /zos/config/mcp
BindReadOnlyPaths=-/run/libvirt/libvirt-sock
NoNewPrivileges=yes
PrivateTmp=yes
CapabilityBoundingSet=
MemoryMax=512M
CPUQuota=150%
TasksMax=256

[Install]
WantedBy=multi-user.target
