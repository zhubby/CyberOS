[Unit]
Description=CyberOS monitoring alert evaluator and delivery worker
Documentation=file:///usr/share/doc/cyberos/README.md
After=network-online.target local-fs.target cyberos-api.service cyberos-monitor.service cyberos-state-init.service
Wants=network-online.target cyberos-api.service cyberos-monitor.service
Requires=cyberos-state-init.service

[Service]
Type=notify
User=cyberos
Group=cyberos
Environment=CYBEROS_ROOT=/cyberos
Environment=CYBEROS_ENVIRONMENT=production
WorkingDirectory=/cyberos/state
ExecStart=/usr/lib/cyberos/bin/cyberos-alerter
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillMode=control-group
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=-/cyberos/data
ReadWritePaths=/run/cyberos /cyberos/state
NoNewPrivileges=yes
PrivateTmp=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=256M
CPUWeight=20
IOWeight=20
TasksMax=64

[Install]
WantedBy=multi-user.target
