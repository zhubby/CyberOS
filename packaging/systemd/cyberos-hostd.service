[Unit]
Description=CyberOS privileged host integration daemon
Documentation=file:///usr/share/doc/cyberos/README.md
After=local-fs.target systemd-tmpfiles-setup.service NetworkManager.service bluetooth.service
Before=network-online.target
Wants=NetworkManager.service bluetooth.service

[Service]
Type=simple
User=root
Group=root
Environment=CYBEROS_ROOT=/cyberos
Environment=CYBEROS_ENVIRONMENT=production
WorkingDirectory=/cyberos/state
ExecStart=/usr/lib/cyberos/bin/cyberos-hostd
Restart=on-failure
RestartSec=3
TimeoutStopSec=180
ProtectSystem=strict
ProtectHome=read-only
# Dynamic share accounts require useradd to atomically replace passwd/shadow files.
ReadWritePaths=/etc /run/cyberos /run/mdadm /cyberos/state/hostd /cyberos/state/shares /cyberos/data
# smbpasswd needs Samba's lock, state, cache, and log directories to initialize its databases.
ReadWritePaths=-/run/samba -/var/lib/samba -/var/cache/samba -/var/log/samba
ReadWritePaths=-/cyberos/state/hostd/docker-daemon /cyberos/state/hostd/network-manager /cyberos/state/hostd/bluetooth
ReadWritePaths=/cyberos/system-backups/permissions
NoNewPrivileges=yes
PrivateTmp=yes
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_MKNOD CAP_SYS_ADMIN CAP_SYS_RAWIO
MemoryMax=128M
CPUQuota=50%
TasksMax=128

[Install]
WantedBy=multi-user.target
