#!/bin/sh
set -eu

runtime_dir=${ZOS_TV_RUNTIME_DIR:-/run/zos-tv}
install -d -m 0700 -o zos -g zos "$runtime_dir" "$runtime_dir/status"
rm -f "$runtime_dir/wayland-0" "$runtime_dir/wayland-0.lock" "$runtime_dir/status/weston.json" \
  "$runtime_dir/status/chromium.json" "$runtime_dir/status/cec.json" \
  "$runtime_dir/status/gamepad.json" "$runtime_dir/weston.log"

config_tmp=$(mktemp "$runtime_dir/.weston.ini.XXXXXX")
trap 'rm -f "$config_tmp"' EXIT HUP INT TERM
cat > "$config_tmp" <<'EOF'
[core]
backend=drm-backend.so
shell=kiosk-shell.so
idle-time=0
xwayland=false

[shell]
locking=false
panel-position=none
EOF

for connector_status in /sys/class/drm/card*-*/status; do
  [ -f "$connector_status" ] || continue
  [ "$(cat "$connector_status")" = connected ] || continue
  connector_dir=${connector_status%/status}
  connector=${connector_dir##*/}
  connector=${connector#*-}
  preferred_mode=$(sed -n '1p' "$connector_dir/modes" 2>/dev/null || true)
  scale=1
  case "$preferred_mode" in 3840x2160*) scale=2 ;; esac
  cat >> "$config_tmp" <<EOF

[output]
name=$connector
mode=preferred
scale=$scale
EOF
done

chmod 0644 "$config_tmp"
chown zos:zos "$config_tmp"
mv -f "$config_tmp" "$runtime_dir/weston.ini"
trap - EXIT HUP INT TERM
