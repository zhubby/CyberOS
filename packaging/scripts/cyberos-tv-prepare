#!/bin/sh
set -eu

test_root=${CYBEROS_TEST_ROOT:-}
case "$test_root" in
  "") runtime_dir=/run/cyberos-tv; drm_root=/sys/class/drm ;;
  /*) runtime_dir="$test_root/run/cyberos-tv"; drm_root="$test_root/sys/class/drm" ;;
  *) printf 'cyberos-tv-prepare: CYBEROS_TEST_ROOT must be absolute\n' >&2; exit 2 ;;
esac
preferred_connector=HDMI-A-1
forced_connectors="$runtime_dir/forced-connectors"

release_forced_connectors() {
  [ -f "$forced_connectors" ] || return 0
  while IFS= read -r connector_status; do
    case "$connector_status" in
      "$drm_root"/card*-HDMI-A-*/status)
        [ -w "$connector_status" ] || continue
        printf '%s\n' detect > "$connector_status" || true
        ;;
    esac
  done < "$forced_connectors"
  rm -f "$forced_connectors"
}

case "${1:-start}" in
  start) ;;
  stop) release_forced_connectors; exit 0 ;;
  *) printf 'cyberos-tv-prepare: usage: cyberos-tv-prepare [start|stop]\n' >&2; exit 2 ;;
esac

install -d -m 0700 -o cyberos -g cyberos "$runtime_dir" "$runtime_dir/status"
rm -f "$runtime_dir/wayland-0" "$runtime_dir/wayland-0.lock" "$runtime_dir/status/weston.json" \
  "$runtime_dir/status/chromium.json" "$runtime_dir/status/cec.json" \
  "$runtime_dir/status/gamepad.json" "$runtime_dir/weston.log" "$forced_connectors"

hdmi_connected=0
for connector_status in "$drm_root"/card*-HDMI-A-*/status; do
  [ -f "$connector_status" ] || continue
  if [ "$(cat "$connector_status")" = connected ]; then
    hdmi_connected=1
    break
  fi
done

if [ "$hdmi_connected" -eq 0 ]; then
  for connector_status in "$drm_root"/card*-"$preferred_connector"/status; do
    [ -w "$connector_status" ] || continue
    if printf '%s\n' on-digital > "$connector_status"; then
      printf '%s\n' "$connector_status" > "$forced_connectors"
      chmod 0600 "$forced_connectors"
      chown cyberos:cyberos "$forced_connectors"
    fi
    break
  done
fi

config_tmp=$(mktemp "$runtime_dir/.weston.ini.XXXXXX")
trap 'rm -f "$config_tmp"' EXIT HUP INT TERM
cat > "$config_tmp" <<'EOF'
[core]
backend=drm-backend.so
shell=kiosk-shell.so
idle-time=0
xwayland=false

[shell]
locking=false
panel-position=none
EOF

for connector_status in "$drm_root"/card*-HDMI-A-*/status; do
  [ -f "$connector_status" ] || continue
  connector_forced=0
  if [ -f "$forced_connectors" ] && grep -Fqx "$connector_status" "$forced_connectors"; then
    connector_forced=1
  fi
  [ "$(cat "$connector_status")" = connected ] || [ "$connector_forced" -eq 1 ] || continue
  connector_dir=${connector_status%/status}
  connector=${connector_dir##*/}
  connector=${connector#*-}
  preferred_mode=$(sed -n '1p' "$connector_dir/modes" 2>/dev/null || true)
  scale=1
  case "$preferred_mode" in 3840x2160*) scale=2 ;; esac
  cat >> "$config_tmp" <<EOF

[output]
name=$connector
mode=preferred
scale=$scale
EOF
done

chmod 0644 "$config_tmp"
chown cyberos:cyberos "$config_tmp"
mv -f "$config_tmp" "$runtime_dir/weston.ini"
trap - EXIT HUP INT TERM
