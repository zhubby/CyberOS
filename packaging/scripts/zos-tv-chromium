#!/bin/sh
set -eu

runtime_dir=${ZOS_TV_RUNTIME_DIR:-/run/zos-tv}
status_writer=${ZOS_TV_SCRIPT_DIR:-/usr/lib/zos/scripts}/zos-tv-write-status
tv_url=${ZOS_TV_URL:-http://127.0.0.1:3010/tv/}
health_url=${ZOS_TV_HEALTH_URL:-http://127.0.0.1:3010/health}
chromium_pid=

cleanup() {
  if [ -n "$chromium_pid" ]; then
    kill "$chromium_pid" 2>/dev/null || true
    wait "$chromium_pid" 2>/dev/null || true
  fi
}
trap cleanup EXIT HUP INT TERM

chromium_bin=$(command -v chromium || command -v chromium-browser || true)
if [ -z "$chromium_bin" ]; then
  "$status_writer" chromium unavailable "Chromium is not installed"
  exit 127
fi

"$status_writer" chromium degraded "Waiting for ZOS TV"
attempt=0
while [ "$attempt" -lt 90 ]; do
  if curl -fsS --max-time 2 "$health_url" >/dev/null 2>&1 && \
     curl -fsS --max-time 2 "$tv_url" >/dev/null 2>&1 && \
     [ -S "$runtime_dir/wayland-0" ]; then
    break
  fi
  attempt=$((attempt + 1))
  sleep 1
done
if [ "$attempt" -ge 90 ]; then
  "$status_writer" chromium unavailable "ZOS TV did not become ready"
  exit 1
fi

install -d -m 0750 /zos/state/tv/chromium
"$chromium_bin" \
  --ozone-platform=wayland \
  --enable-features=UseOzonePlatform \
  --kiosk \
  --app="$tv_url" \
  --user-data-dir=/zos/state/tv/chromium \
  --no-first-run \
  --disable-session-crashed-bubble \
  --disable-infobars \
  --disable-translate \
  --disable-background-networking \
  --disable-component-update \
  --disable-features=MediaRouter,Translate \
  --autoplay-policy=no-user-gesture-required \
  --overscroll-history-navigation=0 &
chromium_pid=$!
sleep 2
if ! kill -0 "$chromium_pid" 2>/dev/null; then
  "$status_writer" chromium unavailable "Chromium exited during startup"
  wait "$chromium_pid"
fi

while kill -0 "$chromium_pid" 2>/dev/null; do
  "$status_writer" chromium ready "/tv/"
  sleep 5
done
wait "$chromium_pid"
