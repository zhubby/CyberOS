#!/bin/sh
set -eu

BASE_DIR=${CYBEROS_DEPLOY_DIR:-/cyberos/deploy}
BASE_DIR=$(realpath -m -- "$BASE_DIR")
case "$BASE_DIR" in
  /cyberos/deploy|/cyberos/deploy/*) ;;
  *) printf 'cyberos-deploy: error: CYBEROS_DEPLOY_DIR must be under /cyberos/deploy\n' >&2; exit 1 ;;
esac
INCOMING_DIR="$BASE_DIR/incoming"
BACKUP_DIR="$BASE_DIR/backups"
RELEASE_DIR="$BASE_DIR/releases"
STATE_PATH="$BASE_DIR/current-release.json"
LOCK_PATH=/run/lock/cyberos-deploy.lock

TIMERS='cyberos-maintenance.timer cyberos-health.timer cyberos-backup-daily.timer cyberos-backup-weekly.timer'
CORE_RUNTIME_SERVICES='cyberos-hostd.service cyberos-terminald.service cyberos-api.service cyberos-worker@1.service cyberos-photos.service cyberos-downloader.service cyberos-bluetoothd.service cyberos-indexer.service'
RUNTIME_SERVICES="$CORE_RUNTIME_SERVICES cyberos-monitor.service cyberos-alerter.service"
SHARE_SERVICES='smbd.service nmbd.service cyberos-webdav.service vsftpd.service nfs-server.service minidlna.service'
OPTIONAL_RUNTIME_SERVICES='cyberos-host-accessd.service'
TV_RUNTIME_TARGET=cyberos-tv.target
WRITERS="cyberos-indexer.service cyberos-maintenance.service cyberos-health.service cyberos-backup-daily.service cyberos-backup-weekly.service $RUNTIME_SERVICES $OPTIONAL_RUNTIME_SERVICES cyberos-vod-player.service"
STATEFUL_RUNTIME_UNITS="$TV_RUNTIME_TARGET $TIMERS $WRITERS"

success=0
work_dir=
backup_path=
failure_dir=
state_dir=
create_upgrade_backup=1

log() {
  printf 'cyberos-deploy: %s\n' "$*"
}

die() {
  log "error: $*" >&2
  exit 1
}

unit_exists() {
  systemctl cat "$1" >/dev/null 2>&1
}

stop_unit() {
  unit=$1
  unit_exists "$unit" || return 0
  systemctl stop "$unit"
}

record_unit_state() {
  unit=$1
  state_dir=$2
  unit_exists "$unit" || return 0
  : > "$state_dir/$unit.recorded"
  if systemctl is-enabled --quiet "$unit" 2>/dev/null; then
    : > "$state_dir/$unit.enabled"
  fi
  if systemctl is-active --quiet "$unit" 2>/dev/null; then
    : > "$state_dir/$unit.active"
  fi
}

restore_tv_runtime_state() {
  state_dir=$1
  unit_exists "$TV_RUNTIME_TARGET" || return 0

  if [ -f "$state_dir/$TV_RUNTIME_TARGET.recorded" ]; then
    restore_unit_state "$TV_RUNTIME_TARGET" "$state_dir"
  else
    systemctl stop "$TV_RUNTIME_TARGET" >/dev/null 2>&1 || true
  fi
}

apply_tv_runtime_settings() {
  settings_path="$work_dir/tv-settings.json"
  curl --fail --silent --show-error --max-time 15 \
    http://127.0.0.1:3010/api/settings/tv > "$settings_path"
  tv_enabled=$(node --input-type=module - "$settings_path" <<'NODE'
import fs from "node:fs";
const settings = JSON.parse(fs.readFileSync(process.argv[2], "utf8"))?.settings;
if (typeof settings?.enabled !== "boolean") throw new Error("TV settings response is invalid");
console.log(settings.enabled ? "enable" : "disable");
NODE
  )
  /usr/lib/cyberos/scripts/cyberos-tv-mode "$tv_enabled"
}

restore_unit_state() {
  unit=$1
  state_dir=$2
  unit_exists "$unit" || return 0
  if [ -f "$state_dir/$unit.enabled" ]; then
    systemctl enable "$unit"
  else
    systemctl disable "$unit" >/dev/null 2>&1 || true
  fi
  if [ -f "$state_dir/$unit.active" ]; then
    systemctl start "$unit"
  else
    systemctl stop "$unit" >/dev/null 2>&1 || true
  fi
}

read_manifest() {
  manifest_path=$1
  node --input-type=module - "$manifest_path" <<'NODE'
import fs from "node:fs";

const manifestPath = process.argv[2];
const manifest = JSON.parse(fs.readFileSync(manifestPath, "utf8"));
const versionPattern = /^[0-9]+\.[0-9]+\.[0-9]+$/u;
const tagPattern = /^v[0-9]+\.[0-9]+\.[0-9]+$/u;
const shaPattern = /^[0-9a-f]{40}$/u;
const checksumPattern = /^[0-9a-f]{64}$/u;

if (!manifest || typeof manifest !== "object" || Array.isArray(manifest)) throw new Error("manifest must be an object");
if (manifest.repository !== "zhubby/CyberOS") throw new Error("manifest repository is not trusted");
if (typeof manifest.version !== "string" || !versionPattern.test(manifest.version)) throw new Error("manifest version is invalid");
if (manifest.tag !== `v${manifest.version}` || !tagPattern.test(manifest.tag)) throw new Error("manifest tag is invalid");
if (typeof manifest.commitSha !== "string" || !shaPattern.test(manifest.commitSha)) throw new Error("manifest commit SHA is invalid");
if (manifest.architecture !== "arm64") throw new Error("manifest architecture is not arm64");
if (manifest.asset !== `cyberos_${manifest.version}_arm64.deb`) throw new Error("manifest asset is invalid");
if (typeof manifest.sha256 !== "string" || !checksumPattern.test(manifest.sha256)) throw new Error("manifest checksum is invalid");

process.stdout.write([
  manifest.repository,
  manifest.tag,
  manifest.version,
  manifest.commitSha,
  manifest.architecture,
  manifest.asset,
  manifest.sha256
].join("\t"));
NODE
}

build_commit() {
  build_path=$1
  node --input-type=module - "$build_path" <<'NODE'
import fs from "node:fs";

const buildPath = process.argv[2];
const build = JSON.parse(fs.readFileSync(buildPath, "utf8"));
if (typeof build.commitSha !== "string" || !/^[0-9a-f]{7,64}$/u.test(build.commitSha)) process.exit(1);
process.stdout.write(build.commitSha.toLowerCase());
NODE
}

wait_for_url() {
  url=$1
  attempts=1
  while [ "$attempts" -le 30 ]; do
    if curl --fail --silent --show-error --max-time 10 "$url" >/dev/null; then
      return 0
    fi
    sleep 2
    attempts=$((attempts + 1))
  done
  return 1
}

wait_for_indexer_ready() {
  status_path="$work_dir/indexer-status.json"
  attempts=1
  while [ "$attempts" -le 120 ]; do
    if curl --fail --silent --show-error --max-time 10 \
      http://127.0.0.1:3010/api/indexer/status > "$status_path" && \
      node --input-type=module - "$status_path" <<'NODE'
import fs from "node:fs";

const status = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const ready = status?.service?.status === "ready" &&
  status.service.freshWorkers > 0 &&
  status?.watcher?.status === "ready" &&
  status?.queue?.stalled === false;
process.exit(ready ? 0 : 1);
NODE
    then
      return 0
    fi
    sleep 2
    attempts=$((attempts + 1))
  done
  [ ! -s "$status_path" ] || cat "$status_path" >&2
  return 1
}

wait_for_health_operation_ready() {
  status_path="$work_dir/system-health.json"
  attempts=1
  while [ "$attempts" -le 60 ]; do
    if curl --fail --silent --show-error --max-time 10 \
      http://127.0.0.1:3010/api/system/health > "$status_path" && \
      node --input-type=module - "$status_path" <<'NODE'
import fs from "node:fs";

const health = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
process.exit(health?.operations?.health?.status === "ready" ? 0 : 1);
NODE
    then
      return 0
    fi
    sleep 2
    attempts=$((attempts + 1))
  done
  [ ! -s "$status_path" ] || cat "$status_path" >&2
  return 1
}

report_monitoring_status() {
  status_path="$work_dir/monitoring-overview.json"
  attempts=1
  while [ "$attempts" -le 15 ]; do
    if curl --fail --silent --show-error --max-time 10 \
      http://127.0.0.1:3010/api/monitoring/overview > "$status_path" && \
      node --input-type=module - "$status_path" <<'NODE'
import fs from "node:fs";

const overview = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const usable = ["ready", "degraded"].includes(overview?.status) &&
  overview.enabled === true &&
  Array.isArray(overview.latest) && overview.latest.length > 0 &&
  Number.isFinite(overview?.retention?.databaseBytes) && overview.retention.databaseBytes > 0;
process.exit(usable ? 0 : 1);
NODE
    then
      monitoring_status=$(node --input-type=module - "$status_path" <<'NODE'
import fs from "node:fs";

const overview = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
process.stdout.write(overview.status);
NODE
      )
      log "monitoring status: $monitoring_status"
      return 0
    fi
    sleep 2
    attempts=$((attempts + 1))
  done
  [ ! -s "$status_path" ] || cat "$status_path" >&2
  log "monitoring did not become ready" >&2
  return 1
}

start_service_stably() {
  unit=$1
  stabilization_seconds=${2:-5}

  systemctl start "$unit"
  systemctl is-active --quiet "$unit" || die "service failed to start: $unit"
  service_before=$(systemctl show --property=MainPID --property=NRestarts "$unit")
  sleep "$stabilization_seconds"
  systemctl is-active --quiet "$unit" || die "service did not remain active: $unit"
  service_after=$(systemctl show --property=MainPID --property=NRestarts "$unit")
  [ "$service_before" = "$service_after" ] || die "service restarted during startup: $unit"
}

activate_runtime() {
  state_dir=$1

  log "stopping CyberOS writers before runtime activation"
  for unit in $STATEFUL_RUNTIME_UNITS; do
    stop_unit "$unit"
  done

  log "enabling CyberOS services"
  systemctl enable $RUNTIME_SERVICES

  log "initializing the installed state schema and credentials"
  systemctl restart cyberos-state-init.service

  log "starting CyberOS runtime prerequisites"
  # An earlier install may have completed this oneshot before DKMS installed
  # LIO. Starting an already-active oneshot would not load the new modules.
  systemctl restart cyberos-iscsi-prepare.service
  # A skipped condition retains an earlier failed state. Clear only that
  # historical state; actual target restoration failures must stay visible.
  if [ "$(systemctl show --property=ConditionResult --value rtslib-fb-targetctl.service)" = no ]; then
    systemctl reset-failed rtslib-fb-targetctl.service
  fi
  start_service_stably cyberos-hostd.service 1
  start_service_stably cyberos-terminald.service 1
  if [ -f "$state_dir/cyberos-host-accessd.service.enabled" ] || systemctl is-enabled --quiet docker.service 2>/dev/null; then
    systemctl enable cyberos-host-accessd.service
    start_service_stably cyberos-host-accessd.service 1
  else
    systemctl disable cyberos-host-accessd.service >/dev/null 2>&1 || true
  fi

  log "starting the API and waiting for startup recovery"
  start_service_stably cyberos-api.service
  wait_for_url http://127.0.0.1:3010/health || die "API startup recovery failed"

  # The player opens the shared SQLite database during startup. Restoring it
  # before the API is healthy lets systemd satisfy After=cyberos-api.service while
  # the API is still completing schema initialization and recovery.
  log "restoring the VOD player after API database recovery"
  restore_unit_state cyberos-vod-player.service "$state_dir"

  log "starting monitoring after API database recovery"
  start_service_stably cyberos-monitor.service

  log "starting alert evaluation after API database recovery"
  start_service_stably cyberos-alerter.service

  log "starting background database writers sequentially"
  start_service_stably cyberos-worker@1.service
  start_service_stably cyberos-photos.service
  start_service_stably cyberos-downloader.service
  start_service_stably cyberos-bluetoothd.service
  start_service_stably cyberos-indexer.service

  log "applying the configured TV appliance mode"
  apply_tv_runtime_settings

  log "refreshing health after all runtime services are stable"
  systemctl start cyberos-health.service

  log "enabling CyberOS schedules"
  systemctl enable $TIMERS
  systemctl start $TIMERS

}

verify_runtime() {
  log "checking CyberOS services"
  for unit in $RUNTIME_SERVICES; do
    systemctl is-enabled --quiet "$unit" || die "service is not enabled: $unit"
    systemctl is-active --quiet "$unit" || die "service is not active: $unit"
  done

  for unit in $TIMERS; do
    systemctl is-enabled --quiet "$unit" || die "timer is not enabled: $unit"
    systemctl is-active --quiet "$unit" || die "timer is not active: $unit"
    timer_schedule=$(systemctl show \
      --property=NextElapseUSecRealtime \
      --property=NextElapseUSecMonotonic \
      "$unit")
    printf '%s\n' "$timer_schedule" | \
      grep -Eq '^NextElapseUSec(Realtime|Monotonic)=.+$' || \
      die "timer has no next trigger: $unit"
  done

  wait_for_url http://127.0.0.1:3010/health || die "API liveness check failed"
  wait_for_url http://127.0.0.1:3010/api/system/storage || die "storage pool status check failed"
  wait_for_url http://127.0.0.1:3010/api/system/health || die "system health endpoint failed"
  wait_for_url http://127.0.0.1:3010/api/system/build-info || die "build-info endpoint failed"
  report_monitoring_status || die "monitoring did not produce a usable sample"
  wait_for_indexer_ready || die "indexer readiness check failed"
  wait_for_health_operation_ready || die "health operation is not ready"

  runtime_before=$(runtime_fingerprint)
  sleep 30
  for unit in $RUNTIME_SERVICES; do
    systemctl is-active --quiet "$unit" || die "service did not remain active: $unit"
  done
  wait_for_url http://127.0.0.1:3010/health || die "API liveness check failed after stabilization"
  wait_for_indexer_ready || die "indexer readiness check failed after stabilization"
  wait_for_health_operation_ready || die "health operation is not ready after stabilization"
  runtime_after=$(runtime_fingerprint)
  if [ "$runtime_before" != "$runtime_after" ]; then
    printf 'runtime before stabilization:\n%s\nruntime after stabilization:\n%s\n' "$runtime_before" "$runtime_after" >&2
    die "one or more services restarted during stabilization"
  fi

  failed_units=$(systemctl --failed --no-legend --plain | awk '$1 ~ /^cyberos-/ { print }' || true)
  if [ -n "$failed_units" ]; then
    printf '%s\n' "$failed_units" >&2
    die "systemd has failed units"
  fi
}

refresh_share_configuration() {
  settings_path="$work_dir/share-settings.json"
  request_path="$work_dir/share-settings-request.json"
  response_path="$work_dir/share-settings-response.json"
  curl --fail --silent --show-error --max-time 15 \
    http://127.0.0.1:3010/api/settings/shares > "$settings_path"
  node --input-type=module - "$settings_path" "$request_path" <<'NODE'
import fs from "node:fs";

const [settingsPath, requestPath] = process.argv.slice(2);
const settings = JSON.parse(fs.readFileSync(settingsPath, "utf8"))?.settings;
if (typeof settings?.account?.username !== "string" || typeof settings?.updatedAt !== "string") {
  throw new Error("share settings response is invalid");
}
fs.writeFileSync(requestPath, JSON.stringify({
  username: settings.account.username,
  expectedUpdatedAt: settings.updatedAt
}));
NODE
  if ! response_status=$(curl --silent --show-error --max-time 120 \
      --output "$response_path" \
      --write-out '%{http_code}' \
      --request PUT \
      --header 'content-type: application/json' \
      --data-binary "@$request_path" \
      http://127.0.0.1:3010/api/shares/account); then
    die "share configuration refresh request failed"
  fi
  node --input-type=module - "$response_path" "$response_status" <<'NODE'
import fs from "node:fs";

const [responsePath, statusRaw] = process.argv.slice(2);
const status = Number(statusRaw);
let response;
try {
  response = JSON.parse(fs.readFileSync(responsePath, "utf8"));
} catch {
  response = null;
}
if (!Number.isInteger(status) || status < 200 || status >= 300) {
  const message = typeof response?.error === "string"
    ? response.error
        .replace(/password["']?\s*[:=]\s*["']?[^\s,"'}]+/giu, "password: [redacted]")
        .replace(/Authorization:\s*\S+/giu, "Authorization: [redacted]")
        .slice(0, 500)
    : "response did not contain a safe error message";
  throw new Error(`share configuration refresh returned HTTP ${statusRaw}: ${message}`);
}
if (typeof response?.appliedAt !== "string") {
  throw new Error(`share configuration refresh failed: ${JSON.stringify(response)}`);
}
NODE
}

runtime_fingerprint() {
  for unit in $RUNTIME_SERVICES; do
    main_pid=$(systemctl show --property=MainPID --value "$unit")
    restart_count=$(systemctl show --property=NRestarts --value "$unit")
    printf '%s:%s:%s\n' "$unit" "$main_pid" "$restart_count"
  done
}

verify_build_info() {
  expected_version=$1
  expected_commit_sha=$2
  node --input-type=module - "$expected_version" "$expected_commit_sha" <<'NODE'
import fs from "node:fs";

const [expectedVersion, expectedCommitSha] = process.argv.slice(2);
const build = JSON.parse(fs.readFileSync("/usr/lib/cyberos/build-info.json", "utf8"));
if (build.version !== expectedVersion || build.commitSha?.toLowerCase() !== expectedCommitSha.toLowerCase()) {
  throw new Error(`build metadata mismatch: ${JSON.stringify(build)}`);
}
NODE
}

record_release() {
  release_tag=$1
  release_version=$2
  release_commit_sha=$3
  release_path="$RELEASE_DIR/$release_tag"
  rm -rf "$release_path"
  install -d -o root -g root -m 0700 "$release_path"
  cp -p "$work_dir/package.deb" "$release_path/package.deb"
  cp -p "$work_dir/release-manifest.json" "$release_path/release-manifest.json"
  cat > "$STATE_PATH" <<EOF
{"tag":"$release_tag","version":"$release_version","commitSha":"$release_commit_sha","packagePath":"$release_path/package.deb","manifestPath":"$release_path/release-manifest.json","deployedAt":"$(date -u +%Y-%m-%dT%H:%M:%SZ)"}
EOF
  chown root:root "$STATE_PATH"
  chmod 0600 "$STATE_PATH"
}

capture_runtime_diagnostics() {
  target_diagnostics_path=$1
  systemctl status $RUNTIME_SERVICES $OPTIONAL_RUNTIME_SERVICES cyberos-vod-player.service $SHARE_SERVICES --no-pager --full > "$target_diagnostics_path/services-status.txt" 2>&1 || true
  systemctl --failed --no-legend --plain > "$target_diagnostics_path/failed-units.txt" 2>&1 || true
  journalctl -u cyberos-api.service -u cyberos-monitor.service -u cyberos-alerter.service -u cyberos-worker@1.service -u cyberos-photos.service -u cyberos-downloader.service -u cyberos-indexer.service -u cyberos-hostd.service -u cyberos-host-accessd.service -u cyberos-terminald.service -u cyberos-vod-player.service -u smbd.service -u nmbd.service -u cyberos-webdav.service -u vsftpd.service -u nfs-server.service -u minidlna.service -n 300 --no-pager > "$target_diagnostics_path/services-journal.txt" 2>&1 || true

  log "service status at failure:" >&2
  cat "$target_diagnostics_path/services-status.txt" >&2
  log "failed units at failure:" >&2
  cat "$target_diagnostics_path/failed-units.txt" >&2
  log "recent service journal at failure:" >&2
  cat "$target_diagnostics_path/services-journal.txt" >&2
}

capture_failure() {
  status=$?
  if [ "$success" -eq 0 ] && [ -n "$failure_dir" ]; then
    log "deployment failed; diagnostics retained at $failure_dir" >&2
    capture_runtime_diagnostics "$failure_dir"
    # dpkg may fail after the package has been unpacked. Restore the exact
    # service/timer state captured before the upgrade so a failed deployment
    # does not leave the appliance permanently stopped.
    if [ -n "$state_dir" ] && [ -d "$state_dir" ]; then
      systemctl daemon-reload >/dev/null 2>&1 || true
      for unit in $WRITERS $TIMERS; do
        restore_unit_state "$unit" "$state_dir" >/dev/null 2>&1 || true
      done
      restore_tv_runtime_state "$state_dir" >/dev/null 2>&1 || true
    fi
  fi
  trap - EXIT
  exit "$status"
}

cleanup_deployment_artifacts() {
  current_release_path="$RELEASE_DIR/$manifest_tag"
  retained_release_count=0

  log "cleaning obsolete deployment artifacts"

  # An interrupted upload can leave complete or partial package parts behind.
  # The helper owns this directory, so it is safe to clear after the deployment
  # lock is held and the current package has been installed.
  find "$INCOMING_DIR" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} + 2>/dev/null || \
    log "warning: unable to remove stale incoming artifacts"

  # Keep the active release and one previous package for a quick rollback. The
  # release directory contains only verified package metadata and a .deb.
  while IFS= read -r release_entry; do
    release_path=${release_entry#* }
    [ "$release_path" = "$current_release_path" ] && continue
    if [ "$retained_release_count" -lt 1 ]; then
      retained_release_count=$((retained_release_count + 1))
      continue
    fi
    rm -rf -- "$release_path" 2>/dev/null || log "warning: unable to remove $release_path"
  done <<EOF
$(find "$RELEASE_DIR" -mindepth 1 -maxdepth 1 -type d -name 'v[0-9]*' -printf '%T@ %p\n' 2>/dev/null | sort -nr)
EOF

  # Deployment backups can contain state needed for package rollback and
  # failure diagnostics. Retention is an explicit operator action.

  # Failed runs can leave work directories beside the managed state. Never
  # traverse outside BASE_DIR and never touch /cyberos/state here.
  find "$BASE_DIR" -mindepth 1 -maxdepth 1 -type d -name 'work.*' -exec rm -rf -- {} + 2>/dev/null || \
    log "warning: unable to remove stale deployment work directories"
}

prepare_incoming() {
  command -v flock >/dev/null 2>&1 || die "flock is required"
  [ -d "$BASE_DIR" ] && [ ! -L "$BASE_DIR" ] || die "deployment directory is unavailable: $BASE_DIR"
  [ -d "$INCOMING_DIR" ] && [ ! -L "$INCOMING_DIR" ] || \
    die "incoming directory is unavailable: $INCOMING_DIR"

  install -d -o root -g root -m 0700 /run/lock
  exec 9>"$LOCK_PATH"
  flock -n 9 || die "another CyberOS deployment is already running"

  # The unprivileged uploader cannot remove root-owned files left by an
  # interrupted helper. Keep cleanup inside the fixed staging directory and
  # behind the same lock used by deployments.
  find "$INCOMING_DIR" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
  log "incoming directory prepared"
}

trap capture_failure EXIT HUP INT TERM

[ "$(id -u)" -eq 0 ] || die "must run as root"

case "${1:-}" in
  --prepare-incoming)
    [ "$#" -eq 1 ] || die "incoming preparation does not accept arguments"
    prepare_incoming
    success=1
    exit 0
    ;;
  --activate-runtime)
    [ "$#" -eq 3 ] || die "internal runtime activation requires a work directory and state directory"
    command -v flock >/dev/null 2>&1 || die "flock is required"
    flock -n 9 || die "internal runtime activation requires the parent deployment lock"
    activation_work_dir=$(realpath -m -- "$2")
    activation_state_dir=$(realpath -m -- "$3")
    case "$activation_work_dir" in
      "$BASE_DIR"/work.*) ;;
      *) die "internal runtime activation work directory is invalid" ;;
    esac
    [ "$activation_state_dir" = "$activation_work_dir/systemd-state" ] || \
      die "internal runtime activation state directory is invalid"
    [ -d "$activation_work_dir" ] && [ ! -L "$activation_work_dir" ] || \
      die "internal runtime activation work directory is unavailable"
    [ -d "$activation_state_dir" ] && [ ! -L "$activation_state_dir" ] || \
      die "internal runtime activation state directory is unavailable"
    work_dir=$activation_work_dir
    state_dir=$activation_state_dir
    activate_runtime "$state_dir"
    verify_runtime
    success=1
    exit 0
    ;;
  --settings-sha256)
    command -v sqlite3 >/dev/null 2>&1 || die "sqlite3 is required"
    [ -f /cyberos/state/cyberos.sqlite ] && [ ! -L /cyberos/state/cyberos.sqlite ] || \
      die "CyberOS database must be a regular file"
    sqlite3 -batch -noheader /cyberos/state/cyberos.sqlite \
      "PRAGMA busy_timeout=5000; SELECT length(key) || ':' || hex(key) || ':' || length(value_json) || ':' || hex(value_json) || ':' || length(updated_at) || ':' || hex(updated_at) FROM system_settings ORDER BY key;" | \
      sha256sum | awk '{ print $1 }'
    exit 0
    ;;
  --settings-upgrade-check)
    [ "$#" -eq 1 ] || die "settings upgrade verification does not accept arguments"
    CYBEROS_ENVIRONMENT=production CYBEROS_ROOT=/cyberos \
      /usr/local/bin/node /usr/lib/cyberos/apps/api/dist/state-init.js --settings-upgrade-check
    exit 0
    ;;
  --database-check)
    command -v sqlite3 >/dev/null 2>&1 || die "sqlite3 is required"
    [ -f /cyberos/state/cyberos.sqlite ] && [ ! -L /cyberos/state/cyberos.sqlite ] || \
      die "CyberOS database must be a regular file"
    database_format=$(sqlite3 /cyberos/state/cyberos.sqlite 'PRAGMA busy_timeout=5000; PRAGMA user_version;' | tail -n 1)
    [ "$database_format" = 3 ] || die "CyberOS database format must be 3: $database_format"
    database_check=$(sqlite3 /cyberos/state/cyberos.sqlite 'PRAGMA busy_timeout=5000; PRAGMA quick_check;' | tail -n 1)
    [ "$database_check" = ok ] || die "CyberOS database quick check failed: $database_check"
    printf '%s\n' "$database_check"
    exit 0
    ;;
  --no-upgrade-backup)
    create_upgrade_backup=0
    ;;
  '') ;;
  *) die "usage: cyberos-deploy [--prepare-incoming|--no-upgrade-backup|--settings-sha256|--database-check]" ;;
esac
[ "$#" -le 1 ] || die "usage: cyberos-deploy [--prepare-incoming|--no-upgrade-backup|--settings-sha256|--database-check]"

command -v node >/dev/null 2>&1 || die "Node.js is required"
command -v apt-get >/dev/null 2>&1 || die "apt-get is required"
command -v dpkg-deb >/dev/null 2>&1 || die "dpkg-deb is required"
command -v flock >/dev/null 2>&1 || die "flock is required"
command -v systemctl >/dev/null 2>&1 || die "systemd is required"

[ -d "$BASE_DIR" ] || die "deployment directory is missing: $BASE_DIR"
install -d -o root -g root -m 0700 /run/lock
exec 9>"$LOCK_PATH"
flock -n 9 || die "another CyberOS deployment is already running"
if [ "$create_upgrade_backup" -eq 1 ]; then
  install -d -o root -g root -m 0700 "$BACKUP_DIR" "$RELEASE_DIR"
else
  log "upgrade backups disabled for this deployment"
  install -d -o root -g root -m 0700 "$RELEASE_DIR"
fi

[ -d "$INCOMING_DIR" ] || die "incoming directory is missing: $INCOMING_DIR"
[ -f "$INCOMING_DIR/package.deb" ] || die "package.deb is missing from incoming directory"
[ -f "$INCOMING_DIR/release-manifest.json" ] || die "release-manifest.json is missing from incoming directory"
[ ! -L "$INCOMING_DIR/package.deb" ] || die "package.deb must not be a symlink"
[ ! -L "$INCOMING_DIR/release-manifest.json" ] || die "release-manifest.json must not be a symlink"

work_dir=$(mktemp -d "$BASE_DIR/work.XXXXXX")
chmod 0700 "$work_dir"
mv -- "$INCOMING_DIR/package.deb" "$work_dir/package.deb"
mv -- "$INCOMING_DIR/release-manifest.json" "$work_dir/release-manifest.json"

# Re-check after moving out of the writable staging directory. This closes the
# symlink replacement window between the initial checks and mv(1).
[ -f "$work_dir/package.deb" ] && [ ! -L "$work_dir/package.deb" ] || die "package.deb must be a regular file"
[ -f "$work_dir/release-manifest.json" ] && [ ! -L "$work_dir/release-manifest.json" ] || die "release-manifest.json must be a regular file"

manifest_data=$(read_manifest "$work_dir/release-manifest.json") || die "invalid release manifest"
IFS="$(printf '\t')" read -r manifest_repository manifest_tag manifest_version manifest_commit_sha manifest_architecture manifest_asset manifest_sha256 <<EOF
$manifest_data
EOF

actual_sha256=$(sha256sum "$work_dir/package.deb" | awk '{print $1}')
[ "$actual_sha256" = "$manifest_sha256" ] || die "package checksum does not match release manifest"

package_version=$(dpkg-deb -f "$work_dir/package.deb" Version)
package_architecture=$(dpkg-deb -f "$work_dir/package.deb" Architecture)
[ "$package_version" = "$manifest_version" ] || die "package version does not match release manifest"
[ "$package_architecture" = arm64 ] || die "package architecture is not arm64"

installed_status=$(dpkg-query -W -f='${Status}' cyberos 2>/dev/null || true)
if [ "$installed_status" = "install ok installed" ]; then
  installed_version=$(dpkg-query -W -f='${Version}' cyberos)
  if dpkg --compare-versions "$manifest_version" lt "$installed_version"; then
    die "refusing to downgrade from $installed_version to $manifest_version"
  fi
  if [ "$manifest_version" = "$installed_version" ]; then
    installed_commit=$(build_commit /usr/lib/cyberos/build-info.json 2>/dev/null || true)
    [ "$installed_commit" = "$(printf '%s' "$manifest_commit_sha" | tr '[:upper:]' '[:lower:]')" ] || die "same package version has a different commit"
    state_dir="$work_dir/systemd-state"
    if [ "$create_upgrade_backup" -eq 1 ]; then
      retry_timestamp=$(date -u +%Y%m%dT%H%M%SZ)
      failure_dir="$BACKUP_DIR/${manifest_tag}-retry-${retry_timestamp}"
      backup_path=$failure_dir
      install -d -o root -g root -m 0700 "$failure_dir"
    else
      failure_dir="$work_dir/failure-diagnostics"
      install -d -o root -g root -m 0700 "$failure_dir"
    fi
    install -d -o root -g root -m 0700 "$state_dir"
    for unit in $STATEFUL_RUNTIME_UNITS; do
      record_unit_state "$unit" "$state_dir"
    done
    if [ "$create_upgrade_backup" -eq 1 ]; then
      cp -a "$state_dir" "$failure_dir/systemd-state"
    fi
    log "version $manifest_version is already installed; recovering runtime and release state"
    /usr/lib/cyberos/scripts/cyberos-deploy --activate-runtime "$work_dir" "$state_dir"
    refresh_share_configuration
    verify_build_info "$manifest_version" "$manifest_commit_sha"
    record_release "$manifest_tag" "$manifest_version" "$manifest_commit_sha"
    cleanup_deployment_artifacts
    success=1
    rm -rf "$failure_dir"
    rm -rf "$work_dir"
    log "recovered $manifest_tag successfully"
    exit 0
  fi
fi

state_dir="$work_dir/systemd-state"
install -d -o root -g root -m 0700 "$state_dir"

if [ "$create_upgrade_backup" -eq 1 ]; then
  timestamp=$(date -u +%Y%m%dT%H%M%SZ)
  backup_path="$BACKUP_DIR/${manifest_tag}-${timestamp}"
  failure_dir=$backup_path
  install -d -o root -g root -m 0700 "$backup_path"
else
  failure_dir="$work_dir/failure-diagnostics"
  install -d -o root -g root -m 0700 "$failure_dir"
fi

for unit in $STATEFUL_RUNTIME_UNITS; do
  record_unit_state "$unit" "$state_dir"
done
if [ "$create_upgrade_backup" -eq 1 ]; then
  cp -a "$state_dir" "$backup_path/systemd-state"
fi

if [ "$create_upgrade_backup" -eq 1 ] && [ -f "$STATE_PATH" ]; then
  previous_package=$(node --input-type=module - "$STATE_PATH" <<'NODE'
import fs from "node:fs";

try {
  const state = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
  if (typeof state.packagePath === "string") process.stdout.write(state.packagePath);
} catch {
  // A missing or malformed state file should not block a first managed upgrade.
}
NODE
  )
  case "$previous_package" in
    "$RELEASE_DIR"/*)
      [ -f "$previous_package" ] && cp -p "$previous_package" "$backup_path/previous-package.deb"
      ;;
  esac
fi

log "stopping scheduled writers and services"
for unit in $STATEFUL_RUNTIME_UNITS; do
  stop_unit "$unit"
done

if [ "$create_upgrade_backup" -eq 1 ]; then
  tar -C /cyberos -czf "$backup_path/state.tgz" state home
fi

log "installing $manifest_tag"
DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-remove \
  -o Dpkg::Options::=--force-confdef \
  -o Dpkg::Options::=--force-confold \
  "$work_dir/package.deb"
systemctl daemon-reload

log "activating runtime with the newly installed deployment helper"
/usr/lib/cyberos/scripts/cyberos-deploy --activate-runtime "$work_dir" "$state_dir"
refresh_share_configuration
verify_build_info "$manifest_version" "$manifest_commit_sha"
record_release "$manifest_tag" "$manifest_version" "$manifest_commit_sha"
cleanup_deployment_artifacts

success=1
rm -rf "$work_dir"
log "deployed $manifest_tag successfully"
