{
  "name": "cyberos",
  "version": "2.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build:metadata && concurrently -n api,worker,monitor,alerter,photos,downloader,vod-player,web -c blue,green,gray,yellow,cyan,white,magenta,blue \"npm run dev -w @cyberos/api\" \"npm run dev -w @cyberos/worker\" \"cargo run -p cyberos-monitor --bin cyberos-monitor\" \"cargo run -p cyberos-alerter\" \"cargo run -p cyberos-photos\" \"cargo run -p cyberos-downloader\" \"cargo run -p cyberos-vod-player\" \"npm run dev -w @cyberos/web\"",
    "index": "cargo run -p cyberos-indexer -- --once",
    "backup": "npm run dev -w @cyberos/backup",
    "health": "npm run dev -w @cyberos/ops -- health",
    "maintenance": "npm run dev -w @cyberos/ops -- maintenance",
    "docs:dev": "npm --prefix docs run dev",
    "docs:check": "npm --prefix docs run check",
    "docs:test": "npm --prefix docs test",
    "docs:build": "npm --prefix docs run build",
    "docs:browser": "npm --prefix docs run browser",
    "build": "npm run build:metadata && npm run build:rust && npm run build --workspaces --if-present && npm run docs:build",
    "build:rust": "cargo build --locked --release --workspace",
    "build:metadata": "node scripts/generate-build-info.mjs",
    "map:build": "./scripts/build-photos-basemap.sh",
    "map:validate": "node scripts/validate-photos-basemap.mjs",
    "protocol:generate": "node scripts/generate-protocol-bindings.mjs",
    "protocol:check": "node scripts/generate-protocol-bindings.mjs --check",
    "release": "node scripts/release.mjs",
    "version:check": "node scripts/version-check.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run docs:check",
    "test": "npm run test:iscsi-helper && cargo test --locked --workspace && vitest run && npm run docs:test",
    "test:iscsi-helper": "python3 -B -m unittest discover -s packaging/helpers -p test_iscsi.py",
    "lint": "cargo fmt --all --check && cargo clippy --locked --workspace --all-targets -- -D warnings && eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.6",
    "eslint": "^9.33.0",
    "tsx": "^4.20.4",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.1.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "echarts": "6.1.0",
    "tsup": {
      "esbuild": "0.28.2"
    },
    "undici": "8.10.2",
    "uuid": "11.1.1"
  }
}
