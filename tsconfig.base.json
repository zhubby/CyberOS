{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@cyberos/agent": ["packages/agent/src/index.ts"],
      "@cyberos/db": ["packages/db/src/index.ts"],
      "@cyberos/nas-tools": ["packages/nas-tools/src/index.ts"],
      "@cyberos/monitoring": ["packages/monitoring/src/index.ts"],
      "@cyberos/monitoring/test-utils": ["packages/monitoring/src/test-utils.ts"],
      "@cyberos/shared": ["packages/shared/src/index.ts"],
      "@cyberos/shared/docker-images": ["packages/shared/src/docker-images.ts"],
      "@cyberos/shared/photostaff-config": ["packages/shared/src/photostaff-config.ts"]
    }
  }
}
