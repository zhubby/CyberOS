{
  "name": "@sigmaos/backup",
  "version": "0.10.7",
  "type": "module",
  "exports": {
    ".": "./src/backup.ts"
  },
  "types": "./src/backup.ts",
  "scripts": {
    "dev": "tsx src/index.ts",
    "once": "tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "cd ../.. && tsup apps/backup/src/index.ts --format esm --platform node --target node22 --external=better-sqlite3 --out-dir apps/backup/dist"
  },
  "dependencies": {
    "@sigmaos/db": "0.10.7",
    "@sigmaos/nas-tools": "0.10.7",
    "@sigmaos/shared": "0.10.7"
  }
}
