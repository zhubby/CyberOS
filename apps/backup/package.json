{
  "name": "@zos/backup",
  "version": "1.4.5",
  "type": "module",
  "exports": {
    ".": "./src/backup.ts"
  },
  "types": "./src/backup.ts",
  "scripts": {
    "dev": "tsx src/index.ts",
    "once": "tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "cd ../.. && tsup apps/backup/src/index.ts --format esm --platform node --target node22 --external=better-sqlite3 --out-dir apps/backup/dist"
  },
  "dependencies": {
    "@zos/db": "1.4.5",
    "@zos/nas-tools": "1.4.5",
    "@zos/shared": "1.4.5"
  }
}
