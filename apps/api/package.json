{
  "name": "@sigmaos/api",
  "version": "0.9.24",
  "type": "module",
  "exports": {
    ".": "./src/server.ts"
  },
  "types": "./src/server.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "cd ../.. && tsup apps/api/src/index.ts --format esm --platform node --target node22 --external=better-sqlite3 --external=@fastify/cors --external=@fastify/static --external=@fastify/websocket --external=archiver --external=fastify --external=yaml --out-dir apps/api/dist"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "@sigmaos/db": "0.9.24",
    "@sigmaos/nas-tools": "0.9.24",
    "@sigmaos/shared": "0.9.24",
    "@sigmaos/system-health": "0.9.24",
    "archiver": "^8.0.0",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^5.12.5",
    "pmtiles": "^4.5.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0"
  }
}
