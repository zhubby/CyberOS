{
  "name": "@sigmaos/indexer",
  "version": "0.9.18",
  "type": "module",
  "exports": {
    ".": "./src/indexer.ts"
  },
  "types": "./src/indexer.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "once": "tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "cd ../.. && tsup apps/indexer/src/index.ts --format esm --platform node --target node22 --external=better-sqlite3 --out-dir apps/indexer/dist"
  },
  "dependencies": {
    "@sigmaos/db": "0.9.18",
    "@sigmaos/nas-tools": "0.9.18",
    "@sigmaos/shared": "0.9.18"
  }
}
