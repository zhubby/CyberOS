CYBEROS_API_HOST=127.0.0.1
CYBEROS_API_PORT=3010
CYBEROS_ALLOW_WORKSPACE_ROOT=1
CYBEROS_ROOT=.cyberos/dev-root
# Optional HTTPS mirror for the byte-identical managed Photostaff base map.
# CYBEROS_PHOTOSTAFF_BASEMAP_URL=https://mirror.example.com/cyberos/natural-earth-ii-3.2.0-raster.pmtiles
# Comma-separated paths, or id:name:path entries.
# CYBEROS_NAS_ROOTS=primary:Primary:.cyberos/dev-root/data/primary
# Optional CORS allowlist for a separately hosted web UI.
# CYBEROS_ALLOWED_ORIGINS=http://127.0.0.1:5173
# Docker management is disabled by default. Docker socket access is root-equivalent.
# CYBEROS_DOCKER_ENABLED=0
# CYBEROS_DOCKER_SOCKET_PATH=/var/run/docker.sock
# CYBEROS_DOCKER_COMPOSE_COMMAND=docker
