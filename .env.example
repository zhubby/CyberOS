SIGMAOS_API_HOST=127.0.0.1
SIGMAOS_API_PORT=3010
SIGMAOS_ALLOW_WORKSPACE_ROOT=1
SIGMAOS_DATA_DIR=.sigmaos
# Optional HTTPS mirror for the byte-identical managed Photostaff base map.
# SIGMAOS_PHOTOSTAFF_BASEMAP_URL=https://mirror.example.com/sigmaos/natural-earth-ii-3.2.0-raster.pmtiles
# Comma-separated paths, or id:name:path entries.
# SIGMAOS_NAS_ROOTS=/srv/nas,media:Media:/mnt/media
# Optional CORS allowlist for a separately hosted web UI.
# SIGMAOS_ALLOWED_ORIGINS=http://127.0.0.1:5173
# Docker management is disabled by default. Docker socket access is root-equivalent.
# SIGMAOS_DOCKER_ENABLED=0
# SIGMAOS_DOCKER_SOCKET_PATH=/var/run/docker.sock
# SIGMAOS_DOCKER_COMPOSE_COMMAND=docker
# SIGMAOS_DOCKER_COMPOSE_ROOTS=apps:Apps:/srv/compose
