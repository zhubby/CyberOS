ZOS_API_HOST=127.0.0.1
ZOS_API_PORT=3010
ZOS_ALLOW_WORKSPACE_ROOT=1
ZOS_ROOT=.zos/dev-root
# Optional HTTPS mirror for the byte-identical managed Photostaff base map.
# ZOS_PHOTOSTAFF_BASEMAP_URL=https://mirror.example.com/zos/natural-earth-ii-3.2.0-raster.pmtiles
# Comma-separated paths, or id:name:path entries.
# ZOS_NAS_ROOTS=primary:Primary:.zos/dev-root/data/primary
# Optional CORS allowlist for a separately hosted web UI.
# ZOS_ALLOWED_ORIGINS=http://127.0.0.1:5173
# Docker management is disabled by default. Docker socket access is root-equivalent.
# ZOS_DOCKER_ENABLED=0
# ZOS_DOCKER_SOCKET_PATH=/var/run/docker.sock
# ZOS_DOCKER_COMPOSE_COMMAND=docker
