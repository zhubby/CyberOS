{
  "name": "@zos/api",
  "version": "1.5.10",
  "type": "module",
  "exports": {
    ".": "./src/server.ts"
  },
  "types": "./src/server.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "cd ../.. && tsup packages/api/src/index.ts --format esm --platform node --target node22 --external=better-sqlite3 --external=@fastify/cors --external=@fastify/rate-limit --external=@fastify/static --external=@fastify/websocket --external=archiver --external=fastify --external=yaml --out-dir packages/api/dist"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "@zos/capability-runtime": "1.5.10",
    "@zos/db": "1.5.10",
    "@zos/mcp": "1.5.10",
    "@zos/monitoring": "1.5.10",
    "@zos/nas-tools": "1.5.10",
    "@zos/shared": "1.5.10",
    "@zos/system-health": "1.5.10",
    "archiver": "^8.0.0",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^5.12.5",
    "pmtiles": "^4.5.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0"
  }
}
