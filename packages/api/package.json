{
  "name": "@cyberos/api",
  "version": "2.0.1",
  "type": "module",
  "exports": {
    ".": "./src/server.ts"
  },
  "types": "./src/server.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "cd ../.. && tsup packages/api/src/index.ts --format esm --platform node --target node22 --external=better-sqlite3 --external=@fastify/cors --external=@fastify/rate-limit --external=@fastify/static --external=@fastify/websocket --external=archiver --external=fastify --external=yaml --out-dir packages/api/dist"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "@cyberos/capabilities": "2.0.1",
    "@cyberos/backup": "2.0.1",
    "@cyberos/capability-runtime": "2.0.1",
    "@cyberos/db": "2.0.1",
    "@cyberos/mcp": "2.0.1",
    "@cyberos/monitoring": "2.0.1",
    "@cyberos/storage-tools": "2.0.1",
    "@cyberos/shared": "2.0.1",
    "@cyberos/system-health": "2.0.1",
    "archiver": "^8.0.0",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^5.12.5",
    "pmtiles": "^4.5.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0"
  }
}
