{
  "name": "@cyberos/backup",
  "version": "2.0.4",
  "type": "module",
  "exports": {
    ".": "./src/backup.ts"
  },
  "types": "./src/backup.ts",
  "scripts": {
    "dev": "tsx src/index.ts",
    "once": "tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "cd ../.. && tsup packages/backup/src/index.ts --format esm --platform node --target node22 --external=better-sqlite3 --out-dir packages/backup/dist"
  },
  "dependencies": {
    "@cyberos/db": "2.0.4",
    "@cyberos/storage-tools": "2.0.4",
    "@cyberos/shared": "2.0.4"
  }
}
